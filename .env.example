# ============================================================
# Configuration de l'assistant — copier ce fichier en .env
# ============================================================

# --- Modèle de langage ---
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-VOTRE-CLE-ICI

# --- Documents ---
DATA_DIR=data

# ============================================================
# PROTECTIONS (server.py)
# ============================================================

# 1. AUTHENTIFICATION
# Mot de passe partagé exigé dans l'en-tête X-API-Password.
# Laisser VIDE désactive l'auth (pratique en local).
# EN PRODUCTION : mettre un mot de passe long et aléatoire.
DEMO_PASSWORD=******

# 2. CORS — domaines autorisés à appeler l'API depuis un navigateur
# Séparés par des virgules, sans espace. Exemple production :
#   ALLOWED_ORIGINS=https://client.com,https://www.client.com
# "*" autorise tout le monde : à réserver à la démo locale.
ALLOWED_ORIGINS=*

# 3. LIMITE DE DÉBIT sur /api/chat, par IP.
# Format : nombre/période. Exemples : 30/minute, 100/hour.
RATE_LIMIT=30/minute

# mot de passe admin pour indexer les documents (distinct du mot de passe du chat)
ADMIN_PASSWORD=*****

# ============================================================
# OPTION TABLEAU DE BORD — journal des questions (opt-in)
# ============================================================
# Désactivé par défaut : rien n'est enregistré tant que LOG_QUESTIONS
# n'est pas mis à 1. Chaque ligne du journal contient UNIQUEMENT :
# date, question, sources citées, refus (oui/non). Ni IP, ni identifiant.
# Les statistiques s'affichent dans gestion.html (section Statistiques).
LOG_QUESTIONS=0

# Dossier du fichier questions.jsonl. Sur Railway, pointer vers le volume
# persistant (ex. LOG_DIR=data/logs si le volume monte data/).
LOG_DIR=logs