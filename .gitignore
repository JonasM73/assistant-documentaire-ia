.env
.env.local
*.key

# Environnement Python
venv/
__pycache__/
*.pyc

# Index vectoriel : données, pas du code. Vit sur le volume persistant (Railway).
chroma_db/

# Documents uploadés par les clients via /admin.html (sur le volume, potentiellement confidentiels).
